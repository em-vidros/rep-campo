# Copie para .env e preencha. O .env nao vai para o GitHub.
# Na Vercel, as mesmas tres primeiras entram em Settings > Environment Variables,
# marcadas para Production.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
REP_SECRET_KEY=gere-com-python3--c-import-secrets-print-secrets-token_hex-32
BLOB_STORE_ID=store_...

# Alerta de correcao de cadastro. Sem isto o aviso so vai para o log.
# Quem revisa cadastro, separado por virgula:
ALERTA_CADASTRO_PARA=
# Um dos dois caminhos de envio (o Resend tem prioridade se os dois existirem):
RESEND_API_KEY=
EMAIL_REMETENTE=
# ou o servidor de e-mail da empresa:
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
